mfltpreset:chord_major3
	a pset:Preset;
	lv2:appliesTo mfltplugin:midichord; rdfs:seeAlso <presets.ttl> .


mfltpreset:chord_sus2
	a pset:Preset;
	lv2:appliesTo mfltplugin:midichord; rdfs:seeAlso <presets.ttl> .


mfltpreset:chord_sus4
	a pset:Preset;
	lv2:appliesTo mfltplugin:midichord; rdfs:seeAlso <presets.ttl> .

mfltpreset:invertcc
	a pset:Preset;
	lv2:appliesTo mfltplugin:scalecc; rdfs:seeAlso <presets.ttl> .

