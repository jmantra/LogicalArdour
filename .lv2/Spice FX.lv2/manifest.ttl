@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pset:  <http://lv2plug.in/ns/ext/presets#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<http://datanoise.com/plugins/spice>
	a lv2:Plugin ;
	lv2:binary <libSpice%20FX.so> ;
	rdfs:seeAlso <dsp.ttl> .

<http://datanoise.com/plugins/spice:UI>
	a ui:X11UI ;
	lv2:binary <libSpice%20FX.so> ;
	rdfs:seeAlso <ui.ttl> .

<http://datanoise.com/plugins/spice:preset1>
	a pset:Preset ;
	lv2:appliesTo <http://datanoise.com/plugins/spice> ;
	rdfs:label "" ;
	state:state [ <http://datanoise.com/plugins/spice:Program> "0"^^xsd:int ; ] .

