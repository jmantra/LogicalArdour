@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix pset:  <http://lv2plug.in/ns/ext/presets#> .

<http://zynaddsubfx.sourceforge.net/fx#Reverse:preset001>
    lv2:port [
        lv2:symbol "delay" ;
        pset:value 25 ;
    ] ,
    [
        lv2:symbol "stereo" ;
        pset:value 0 ;
    ] ,
    [
        lv2:symbol "phase" ;
        pset:value 64 ;
    ] ,
    [
        lv2:symbol "crossfade" ;
        pset:value 32 ;
    ] ,
    [
        lv2:symbol "syncMode" ;
        pset:value -2 ;
    ] ,
    [
        lv2:symbol "numerator" ;
        pset:value 0 ;
    ] ,
    [
        lv2:symbol "denominator" ;
        pset:value 4 ;
    ] .

