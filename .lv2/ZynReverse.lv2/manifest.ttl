@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .

<http://zynaddsubfx.sourceforge.net/fx#Reverse>
    a lv2:Plugin ;
    lv2:binary <ZynReverse.so> ;
    rdfs:seeAlso <ZynReverse.ttl> .

<http://zynaddsubfx.sourceforge.net/fx#Reverse:preset001>
    a pset:Preset ;
    lv2:appliesTo <http://zynaddsubfx.sourceforge.net/fx#Reverse> ;
    rdfs:label "Note On" ;
    rdfs:seeAlso <presets.ttl> .

<http://zynaddsubfx.sourceforge.net/fx#Reverse:preset002>
    a pset:Preset ;
    lv2:appliesTo <http://zynaddsubfx.sourceforge.net/fx#Reverse> ;
    rdfs:label "Note On/Off" ;
    rdfs:seeAlso <presets.ttl> .

<http://zynaddsubfx.sourceforge.net/fx#Reverse:preset003>
    a pset:Preset ;
    lv2:appliesTo <http://zynaddsubfx.sourceforge.net/fx#Reverse> ;
    rdfs:label "Auto" ;
    rdfs:seeAlso <presets.ttl> .

<http://zynaddsubfx.sourceforge.net/fx#Reverse:preset004>
    a pset:Preset ;
    lv2:appliesTo <http://zynaddsubfx.sourceforge.net/fx#Reverse> ;
    rdfs:label "Custom Preset" ;
    rdfs:seeAlso <presets.ttl> .

<http://zynaddsubfx.sourceforge.net/fx#Reverse:preset005>
    a pset:Preset ;
    lv2:appliesTo <http://zynaddsubfx.sourceforge.net/fx#Reverse> ;
    rdfs:label "Custom Preset" ;
    rdfs:seeAlso <presets.ttl> .


